# Copy to .env and fill in. Never commit .env.
# Neon: copy the connection string from the dashboard (postgresql://...?sslmode=require).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobmatch
# Optional separate DB for the pytest DB tests (use a Neon branch or local pgvector)
TEST_DATABASE_URL=

GEMINI_API_KEY=
CHAT_MODEL=gemini-3.1-flash-lite
# ordered fallback chain: free-tier quotas are per model
CHAT_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-2.5-flash
# local = fastembed/ONNX (free, unlimited). gemini = 1,000 texts/day on the free tier.
EMBED_PROVIDER=local
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384

JWT_SECRET=generate-a-long-random-string
RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
ENVIRONMENT=dev
